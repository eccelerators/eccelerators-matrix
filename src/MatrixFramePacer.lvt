namespace Eccelerators.Matrix

/**
 * Context-derived presentation deadlines, independent of rendering duration.
 * One serialized client waits after drawing and before Present. Zero disables
 * pacing. Missed deadlines coalesce; they do not create a backlog of requests.
 */
component MatrixFramePacer<INTERVAL: Time = 80ms>
{
	static assert INTERVAL >= 0ns, "Frame interval must not be negative"

	// Clock process owns elapsed and epoch; scheduled caller owns observed.
	intervalTicks: uint
	elapsed: uint
	epoch: uint
	observed: uint

	/**
	 * Derive the interval from the inherited clock; begin deadlines at construction.
	 */
	new()
	{
		static if (INTERVAL > 0ns) {
			intervalTicks = context.TicksFor(INTERVAL)
			assert intervalTicks > 0, "Frame interval must span at least one clock"
		}
	}

	/**
	 * Wait for an unconsumed deadline, or return immediately when pacing is disabled.
	 */
	public fn WaitNext()
	{
		static if (INTERVAL > 0ns) {
			while (epoch == observed) {
			}

			observed = epoch
		}
	}

	/**
	 * Count continuously while the application prepares its next frame.
	 */
	process Count()
	{
		static if (INTERVAL > 0ns) {
			state {
				if (elapsed == intervalTicks - 1) {
					elapsed = 0
					epoch++
				} else {
					elapsed++
				}
			}
		}
	}
}
